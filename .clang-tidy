# Static analysis for native/; `uv run poe lint` runs it on build/<preset>/compile_commands.json.
# Disabled checks are style preferences that do not fit this small POSIX-facing code:
# - designated initializers, trailing commas: positional getopt tables and aggregate returns
# - math parentheses: ordinary arithmetic precedence needs none
# - raw string literals: JSON is emitted through escaped printf formats
# - deprecated headers: the POSIX code deliberately uses C headers and unqualified C names
# - pragma once: supported by every targeted compiler
# - non-copyable objects: FILE is passed by reference, never copied
# - enum size: a few tiny enums; int also matches getopt_long's return type
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  clang-analyzer-*,
  concurrency-*,
  misc-*,
  -misc-include-cleaner,
  -misc-non-copyable-objects,
  -misc-non-private-member-variables-in-classes,
  modernize-*,
  -modernize-avoid-c-arrays,
  -modernize-deprecated-headers,
  -modernize-raw-string-literal,
  -modernize-use-designated-initializers,
  -modernize-use-trailing-return-type,
  performance-*,
  -performance-enum-size,
  portability-*,
  -portability-avoid-pragma-once,
  readability-*,
  -readability-braces-around-statements,
  -readability-function-cognitive-complexity,
  -readability-identifier-length,
  -readability-implicit-bool-conversion,
  -readability-magic-numbers,
  -readability-math-missing-parentheses,
  -readability-trailing-comma
CheckOptions:
  bugprone-signed-bitwise.IgnorePositiveIntegerLiterals: true
  misc-const-correctness.AnalyzePointers: false
  performance-unnecessary-value-param.AllowedTypes: 'std::stop_token'
WarningsAsErrors: '*'
HeaderFilterRegex: 'native/'
